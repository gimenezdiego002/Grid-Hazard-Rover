# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Maps Platform
# Shared key for Routes API and Geocoding API.
GOOGLE_MAPS_API_KEY=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=grid_hazard_rover

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# Signing secret from ElevenLabs workspace post-call webhook settings.
ELEVENLABS_WEBHOOK_SECRET=
# Generate a long random server-side token; enter it in the dashboard at runtime.
CALLS_DASHBOARD_TOKEN=
# Local demo only. Production should use private durable object storage.
ELEVENLABS_SAVE_CALL_AUDIO=false
CALL_AUDIO_STORAGE_DIR=.state/call-audio
CALL_AUDIO_MAX_BYTES=15000000

# Discord
DISCORD_WEBHOOK_URL=

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# FNK0052 robot (safe defaults; the kit has no assumed GPS)
ROBOT_MODE=mock
ROBOT_ID=freenove-fnk0052-01
ROBOT_ALLOW_PHYSICAL_ACTUATION=false
ROBOT_FREENOVE_SERVER_PATH=
ROBOT_BACKEND_URL=http://127.0.0.1:8000
ROBOT_RELAY_URL=http://127.0.0.1:8000/relay/fleet
ROBOT_LOCATION_MODE=none
ROBOT_FIXED_LONGITUDE=
ROBOT_FIXED_LATITUDE=
ROBOT_NAVIGATION_ENABLED=false
ROBOT_OBSTACLE_DISTANCE_CM=30
ROBOT_SENSOR_MAX_AGE_SECONDS=2
