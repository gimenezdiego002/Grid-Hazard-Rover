# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Maps Platform
# Use separate keys so each can be restricted to only its required API.
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=grid_hazard_rover

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Discord
DISCORD_WEBHOOK_URL=

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
