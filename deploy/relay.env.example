# Configuration template only: no application command automatically loads .env.
# Secrets belong in a process environment or runtime secret manager, never Git,
# the browser, Docker build arguments, or a container image.
# Dashboard/API/integrations CLI are always mock; credentials cannot enable them.
RELAY_PROVIDER=mock
RELAY_STORE_PATH=.state/governance.sqlite
# Packaged/container server only: explicit directory containing web/ and scenarios/.
# RELAY_ASSET_ROOT=/app

# Primary cloud context for deployment/inventory tools; not a runtime credential.
GCP_PROJECT_ID=shellhacks-relay-2026-0926
GCP_REGION=us-east1
# A restricted project Gemini key is stored in Secret Manager as
# relay-gemini-api-key. Retrieve/inject it only into an authorized live process.
# The mock dashboard must not receive it.

# Live Gemini requires demo --live, this switch, and shared-budget admission.
# The selected rates were checked 2026-09-26; reverify before later paid use.
RELAY_ALLOW_LIVE_GEMINI=0
# Optional standalone Jev supervisor; normal CLI/HTTP remain mock-only.
# Hosted TypeSafe model is pinned in jev_provider.py; this is not OpenJev.
RELAY_ALLOW_LIVE_JEV=0
TYPESAFE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Reviewed native thinking config: gemini-3.5-flash-lite / gemini-3.8-flash use
# thinking_level=minimal. Legacy gemini-2.5-flash[-lite] use thinking_budget=0.
# USD per million tokens; output includes thinking tokens.
# Text metadata + bounded reference passages only; evidence URIs are not decoded.
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50

# Mission records use MONGODB_URI or POLLARD_MONGODB_URI. If both are set, they
# must match. Pollard specifically reads POLLARD_MONGODB_URI and requires explicit
# --store mongodb. Merely defining a URI must not select a remote store.
# Bounded data proofs also require explicit --live and shared-budget admission.
RELAY_ALLOW_LIVE_DATA=0
MONGODB_URI=
MONGODB_DATABASE=relay
POLLARD_MONGODB_URI=
POLLARD_MONGODB_DATABASE=relay
POLLARD_MONGODB_PREFIX=pollard
POLLARD_STORE_ID=relay-hackathon
# The shared spending ledger is .state/spend.sqlite; do not reset or move it onto
# ephemeral cloud storage to obtain a fresh allowance. Cloud live mode remains
# separate from these mock deployments and needs durable shared admission.

# Tiger Data PostgreSQL; live=True and a budgeted operation are explicit.
# Runtime forces verified TLS; replace system with a trusted CA file if needed.
TIGER_DATABASE_URL=
TIGER_SSLROOTCERT=system

# Snowflake SQL REST API reference retrieval. No Cortex Search service is needed.
# Account is an identifier (organization-account), not an arbitrary URL.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
SNOWFLAKE_TOKEN_TYPE=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# Speech generation is an explicit, reviewed, budgeted live operation.
RELAY_ALLOW_ELEVENLABS=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# The guarded speech CLI requires this explicit model; validate account pricing.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Solana is fixed to https://api.devnet.solana.com in the implementation.
# There is no SOLANA_RPC_URL or SOLANA_KEYPAIR_PATH setting. The project owns a
# dedicated .state/solana/devnet-keypair.json; never copy its private bytes here.
RELAY_ALLOW_SOLANA_DEVNET=0

# DigitalOcean account token: local account/provisioning tools only.
# It is not the gateway's API authentication token and must not reach its runtime.
DIGITALOCEAN_ACCESS_TOKEN=
# Separate fleet service. Default CLI/mock fixtures stay local.
RELAY_FLEET_MODE=mock
RELAY_FLEET_API_TOKEN=
RELAY_FLEET_TTL_SECONDS=3600
RELAY_FLEET_MAX_EVENTS=5000

# Domain metadata for optional DNS checks; not registration or ownership proof.
GODADDY_DOMAIN=
